# ============================================
# Discord Bot Configuration
# ============================================

# Discord Bot Token (dari Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID
CLIENT_ID=your_client_id_here

# Guild ID untuk testing (opsional, hapus untuk global commands)
GUILD_ID=your_guild_id_here

# ============================================
# Puter.js (FREE AI - Tidak butuh API key!)
# ============================================

# Auth token dari akun Puter.com (OPSIONAL)
# Jika tidak diisi, bot akan membuka browser sekali untuk login
# Setelah login, token akan ditampilkan di console untuk disimpan di sini
# PUTER_AUTH_TOKEN=your_puter_auth_token_here

# ============================================
# Rewind AI (OPSIONAL - Fallback jika Puter gagal)
# ============================================

# REWIND_API_KEY=your_rewind_api_key_here
# REWIND_BASE_URL=https://api.rewind.ai/v1

# ============================================
# Database Configuration
# ============================================

# Prisma database URL (SQLite default)
DATABASE_URL="file:./dev.db"

# ============================================
# Bot Settings (Opsional)
# ============================================

# Log Channel ID untuk audit log
# AUDIT_LOG_CHANNEL_ID=your_log_channel_id_here
