# ============================================
# Discord Bot Configuration
# ============================================

# Discord Bot Token (dari Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID
CLIENT_ID=your_client_id_here

# Guild ID untuk testing (opsional, hapus untuk global commands)
GUILD_ID=your_guild_id_here

# ============================================
# Puter.js (FREE AI - Tidak butuh API key!)
# ============================================

# Auth token dari akun Puter.com (OPSIONAL)
# Jika tidak diisi, bot akan membuka browser sekali untuk login
# Setelah login, token akan ditampilkan di console untuk disimpan di sini
# PUTER_AUTH_TOKEN=your_puter_auth_token_here

# ============================================
# Rewind AI (OPSIONAL - Fallback jika Puter gagal)
# ============================================

# REWIND_API_KEY=your_rewind_api_key_here
# REWIND_BASE_URL=https://api.rewind.ai/v1

# ============================================
# Database Configuration
# ============================================

# Prisma database URL (PostgreSQL / NeonDB)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Database SQLite lama — hanya dipakai oleh scripts/migrate-sqlite-to-neon.mjs
SQLITE_DATABASE_URL="file:./dev.db"

# ============================================
# Bot Settings (Opsional)
# ============================================

# Log Channel ID untuk audit log
# AUDIT_LOG_CHANNEL_ID=your_log_channel_id_here

# ============================================
# Engine Audio Native (opsional)
# Aktifkan lewat /engine use type:native
# ============================================

# Engine native memakai pustaka youtubei.js (npm) — tidak butuh yt-dlp,
# tidak butuh cookie, dan tidak perlu refresh cookie.

# Path binary FFmpeg (opsional). Tanpa FFmpeg, engine native hanya bisa
# memutar sumber Opus (YouTube webm/opus) dan volume realtime tidak tersedia.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Proxy untuk request YouTube + unduhan media googlevideo.
# Berguna jika host googlevideo diblokir atau DNS-nya di-hijack ISP.
#
# DEFAULT PRODUCTION: biarkan kosong. Bot otomatis scrape + menguji proxy HTTP
# DAN SOCKS5 (proxifly, pubproxy, dll), lalu memakai yang bisa menjangkau
# googlevideo.com:443. Proxy diganti otomatis jika mati, dan di-scrape ulang
# tiap 10 menit (TTL) atau saat pool habis. Format didukung:
#   http://host:port  |  socks5://host:port  |  socks5://user:pass@host:port
# YOUTUBE_PROXY_AUTO=true
#
# Override manual (opsional). Jika diisi, auto-fetch dimatikan dan proxy ini
# selalu dipakai. Format: http://host:port atau socks5://host:port
# YOUTUBE_PROXY=http://127.0.0.1:8080

# ============================================
# Anti-stutter Lavalink (opsional)
# ============================================
# Node publik mengirim frame sebelum buffer-terisi → tersendat di awal lagu.
# Bot mulai dengan track paused, tunggu sekian ms, lalu unpause. Default: 1500.
# LAVALINK_WARMUP_MS=1500
