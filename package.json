{
  "name": "discord-bot-adventure",
  "version": "1.0.0",
  "description": "Professional Discord bot with Admin, AI Fun, and RPG Adventure features",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "setup": "npm install && npx prisma generate && npx prisma db push"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.3.2",
    "@prisma/client": "^6.9.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.5.0",
    "kazagumo": "^3.4.3",
    "shoukaku": "^4.3.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
